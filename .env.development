# `npm run dev` against a local backend in its mock profile (sono-game: ./gradlew bootRun).
# Mock launch tokens work only there. To test on a phone, put your computer's LAN address into an
# untracked .env.development.local, e.g. VITE_API_BASE_URL=http://192.168.1.10:8080
VITE_API_BASE_URL=http://localhost:8080
VITE_API_TEST_MOCK_AUTH=1
