# Example only. Include inside nginx's http {} context, after mime.types.
# Replace all example domains, certificate paths and the Play upstream address.
# Static vhost belongs on vendor hosting; API vhost/upstream belong on the Play VPS.
# Split the relevant blocks between those hosts when they are separate machines.

map $http_origin $sono_cors_origin {
    default "";
    "https://miniapps.example.com" $http_origin;
}

upstream sono_play_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name miniapps.example.com play-api.example.com;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name miniapps.example.com;
    ssl_certificate /etc/letsencrypt/live/miniapps.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/miniapps.example.com/privkey.pem;

    # current -> releases/<release-id>; each release contains sono-play/<dist files>.
    root /srv/sono-play/current;
    index index.html;
    etag on;
    expires off;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml font/ttf;
    error_page 404 = @sono_static_missing;

    location = /sono-play {
        return 308 /sono-play/$is_args$args;
    }

    location = /sono-play/ {
        try_files /sono-play/index.html =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /sono-play/index.html {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /sono-play/release-manifest.json {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    # Only compiler-generated content-hashed runtime assets enter this namespace.
    # Shared storage retains old hashes for already-open WebViews and rollback.
    location ^~ /sono-play/assets/static/ {
        root /srv/sono-play/shared;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Vite's fingerprinted JS/CSS bundles, excluding any unversioned public files.
    location ~ '^/sono-play/assets/[A-Za-z0-9_-]+-[A-Za-z0-9_-]{8,}\.(js|css)$' {
        root /srv/sono-play/shared;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /sono-play/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
    }

    location @sono_static_missing {
        add_header Cache-Control "no-store" always;
        return 404;
    }

    # Optional same-origin gateway. Enable only if this origin's /api/v1 namespace
    # is assigned to Play, and build with an empty VITE_API_BASE_URL.
    # location ^~ /api/v1/ {
    #     proxy_pass https://play-api.example.com;
    #     proxy_ssl_server_name on;
    #     proxy_ssl_verify on;
    #     proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    #     proxy_set_header Host play-api.example.com;
    #     proxy_set_header Authorization $http_authorization;
    #     proxy_set_header Idempotency-Key $http_idempotency_key;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_cache off;
    #     proxy_no_cache 1;
    #     proxy_cache_bypass 1;
    #     proxy_hide_header Cache-Control;
    #     proxy_hide_header Expires;
    #     add_header Cache-Control "private, no-store, max-age=0" always;
    # }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    server_name play-api.example.com;
    expires off;
    ssl_certificate /etc/letsencrypt/live/play-api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/play-api.example.com/privkey.pem;

    location ^~ /api/v1/ {
        # No URI suffix: the original /api/v1/... path is preserved.
        proxy_pass http://sono_play_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Idempotency-Key $http_idempotency_key;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_cache off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        # CORS is owned by this gateway; avoid duplicate upstream headers.
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_hide_header Access-Control-Max-Age;

        # Keep API auth/profile/order/me data out of browser/CDN shared caches.
        add_header Cache-Control "private, no-store, max-age=0" always;
        add_header Vary "Origin" always;
        add_header Access-Control-Allow-Origin $sono_cors_origin always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Idempotency-Key" always;
        add_header Access-Control-Expose-Headers "Retry-After, X-Request-Id" always;
        add_header Access-Control-Max-Age "600" always;

        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    location / {
        return 404;
    }
}
