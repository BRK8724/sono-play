# nginx config of the web client's container (see Dockerfile). The mini-app under /sono-play/ and the
# Player API under /api/v1/ share one origin, so the browser needs no CORS. ${API_UPSTREAM} and
# ${NGINX_RESOLVER} are filled in by the nginx image at start-up from the environment.

# Keep the scheme a TLS proxy in front reports; otherwise this server's own.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 8080;
    server_tokens off;
    # Relative Location headers: the published port and a TLS proxy in front differ from 8080.
    absolute_redirect off;
    root /usr/share/nginx/html;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml font/ttf;

    location = / {
        return 302 /sono-play/;
    }
    location = /sono-play {
        return 308 /sono-play/;
    }

    # Content-hashed files never change.
    location ^~ /sono-play/assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
    # index.html and release-manifest.json are checked on every load.
    location /sono-play/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
    }

    # The Player API only. /internal/** (core app, HMAC), /actuator and the API docs are not
    # reachable through this server.
    location ^~ /api/v1/ {
        # Resolve the backend's name per request (cached 10 s): a redeployed backend container gets a
        # new address, and a name resolved once at start-up would keep answering 502.
        resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # The backend trusts private-network proxies and takes the client address from here
        # (per-IP login limit).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
        client_max_body_size 16k;
    }

    location / {
        return 404;
    }
}
